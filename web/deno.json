{
  "$schema": "https://raw.githubusercontent.com/denoland/deno/refs/heads/main/cli/schemas/config-file.v1.json",
  "name": "@downtimer/web",
  "version": "0.4.0",
  "exports": {},
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check",
    "dev": "vite",
    "build": "vite build",
    "start": "deno serve -A _fresh/server.js",
    "update": "deno run -A -r jsr:@fresh/update .",
    "compile": "deno compile --output dt-web --include _fresh -A _fresh/compiled-entry.js"
  },
  "lint": {
    "rules": {
      "tags": [
        "fresh",
        "recommended"
      ],
      "exclude": [
        "react-no-danger"
      ]
    },
    "exclude": [
      "static/*"
    ]
  },
  "exclude": [
    "**/_fresh/*"
  ],
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns",
      "deno.unstable"
    ],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": [
      "vite/client"
    ]
  },
  "imports": {
    "@deno/gfm": "jsr:@deno/gfm@^0.12.0",
    "@tailwindcss/forms": "npm:@tailwindcss/forms@^0.5.11",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "preact": "npm:preact@^10.29.2",
    "@preact/signals": "npm:@preact/signals@^2.9.0",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.1.2",
    "vite": "npm:vite@^8.0.13",
    "tailwindcss": "npm:tailwindcss@^4.3.0",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.3.0",
    "preact/compat": "npm:preact@^10.29.2/compat",
    "octokit": "npm:@octokit/core@^7.0.6",
    "octokit/types": "npm:@octokit/types@^16.0.0"
  }
}